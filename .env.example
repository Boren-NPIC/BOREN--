# APP_URL: The URL where this application is hosted (injected in AI Studio or set on Vercel/Cloud Run)
APP_URL="http://localhost:3000"

# STREAM_SIGNING_SECRET: HMAC secret used by Express backend to sign short-lived video playback URLs
STREAM_SIGNING_SECRET="change-this-to-a-long-random-secret-in-production"

# ==============================================================================
# CAMBODIA PAYMENT GATEWAY CREDENTIALS (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# If left empty, BORINA TV displays a Setup-Required notice and Pending Manual
# Verification workflow instead of faking paid transactions.
# ==============================================================================

# KHQR (Bakong / National Bank of Cambodia)
KHQR_MERCHANT_ID=""
KHQR_MERCHANT_NAME="BORINA TV"
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_ACCOUNT_ID=""
KHQR_API_TOKEN=""
KHQR_WEBHOOK_SECRET=""

# ABA PayWay (ABA Bank Cambodia)
ABA_PAYWAY_MERCHANT_ID=""
ABA_PAYWAY_API_KEY=""
ABA_PAYWAY_API_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase"
ABA_PAYWAY_CHECK_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2"
