rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ren58791@gmail.com';
    }

    function isValidImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isValidVideo() {
      return request.resource.size <= 2 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm|quicktime|x-matroska)|application/vnd.apple.mpegurl|application/x-mpegURL');
    }

    function isValidSubtitle() {
      return request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('text/(vtt|plain)|application/x-subrip');
    }

    match /posters/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /videos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidVideo();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /subtitles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidSubtitle();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}
